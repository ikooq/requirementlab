{
  "document": "docs/requirements.md",
  "sha256": "e7dae55e5453a250d93e335f5ff9c7f775f4457ccddd333f4a67e47b20d74381",
  "about": "Эталонный список дефектов документа кейса, составлен вручную. Находка агента засчитывается за дефект, если её цитата попадает в одну из строк lines (допуск ±1 строка) и текст находки подходит под каждую группу keywords (регулярные выражения, без учёта регистра, ё = е). lines = null — место не важно (дефект всего набора). Веса: critical 3, major 2, minor 1. G01–G35 составлены до прогонов агента; G36–G41 — находки агента v1.3.0 вне эталона, проверенные по документу.",
  "defects": [
    {
      "id": "G01", "severity": "critical", "kind": "противоречие",
      "title": "Ф-2 (месяц по дате совершения покупки) противоречит AC-2 (покупка 31 января попадает в февраль)",
      "lines": [38, 64],
      "keywords": ["феврал|январ|23:58|00:03|ac-2"]
    },
    {
      "id": "G02", "severity": "critical", "kind": "противоречие",
      "title": "Ф-3 (не больше одного push за месяц) противоречит Ф-4 (push после смены порога независимо от истории)",
      "lines": [39, 40],
      "keywords": ["ф-3|один\\w* (такой )?push|максимум один|одн\\w+ уведомлен", "ф-4|изменени\\w* порог|нов\\w* порог|смен\\w* порог"]
    },
    {
      "id": "G03", "severity": "critical", "kind": "противоречие",
      "title": "Метод сохранения объявлен как GET: изменение состояния через безопасный метод",
      "lines": [104, 109, 120],
      "keywords": ["\\bget\\b"]
    },
    {
      "id": "G04", "severity": "critical", "kind": "противоречие",
      "title": "Ошибка суммы возвращается с кодом 200 и result=ERROR, хотя для неверных параметров предусмотрен 400",
      "lines": [121, 151, 162, 163, 165, 169, 171],
      "keywords": ["200", "error|ошибк|400"]
    },
    {
      "id": "G05", "severity": "critical", "kind": "неполнота",
